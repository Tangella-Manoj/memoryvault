{
  "manifest_version": 3,
  "name": "MemoryVault",
  "version": "1.0.0",
  "key": "",
  "description": "Save anything to MemoryVault in one click, and let it resurface when you need it.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:8091/*",
    "https://api.stacknode.dev/*",
    "https://www.instagram.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.google.com/*",
    "https://www.bing.com/*",
    "https://duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://twitter.com/*", "https://x.com/*"],
      "js": ["twitter.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.bing.com/search*",
        "https://duckduckgo.com/*"
      ],
      "js": ["search-overlay.js"],
      "css": ["search-overlay.css"],
      "run_at": "document_idle"
    }
  ]
}
