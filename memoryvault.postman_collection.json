  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates a new account. On success, stores accessToken/refreshToken/userId as collection variables for subsequent requests.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"correcthorsebattery\",\n  \"displayName\": \"Postman Tester\"\n}"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is expected', function () {",
                  "    pm.expect([200,201,202,400,401,403,404,409,429]).to.include(pm.response.code);",
                  "});",
                  "pm.test('response has ApiResponse envelope', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json).to.have.property('timestamp');",
                  "    pm.expect(json).to.have.property('requestId');",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    const data = pm.response.json().data;",
                  "    pm.collectionVariables.set('accessToken', data.accessToken);",
                  "    pm.collectionVariables.set('refreshToken', data.refreshToken);",
                  "    pm.collectionVariables.set('userId', data.userId);",
                  "}"
                ]
              }
            }
          ]
        },
