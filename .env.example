# ---- MySQL (Docker) ----
MYSQL_ROOT_PASSWORD=changeme_root
MYSQL_DATABASE=memoryvault
MYSQL_USER=memoryvault_app
MYSQL_PASSWORD=changeme_local_dev
MYSQL_PORT=33061

# ---- phpMyAdmin ----
PHPMYADMIN_PORT=8086

# ---- Spring Boot ----
SPRING_PROFILE=dev
DB_HOST=localhost
DB_PORT=33061
DB_NAME=memoryvault
DB_USER=memoryvault_app
DB_PASSWORD=changeme_local_dev
SERVER_PORT=8091

# ---- JWT ----
# Required, no default — must be >= 256 bits (32 bytes). Generate with: openssl rand -hex 32
JWT_SECRET=changeme_run_openssl_rand_hex_32_and_paste_the_output_here
JWT_ACCESS_EXPIRY_MS=86400000
JWT_REFRESH_EXPIRY_MS=604800000

# ---- AI stack (Upgrade 8: replaces the paid Claude API) ----
# Dev: local Ollama (docker-compose service `ollama`, port 11434) — no key needed, runs free
# on your own machine. Models (llama3.1:8b, nomic-embed-text) are auto-pulled on startup.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Prod: Groq's free-tier-friendly OpenAI-compatible API for text generation.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=changeme_groq_api_key
# Prod: HuggingFace's hosted inference API for embeddings (free tier).
# Get a key at https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=changeme_huggingface_api_key

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api

# ---- Email ingestion (Upgrade 3) ----
# Domain used for each user's generated personal vault email ({8-hex-chars}@this-domain)
VAULT_EMAIL_DOMAIN=vault.stacknode.dev
# Self-hosted SMTP receiver fallback (used when Mailgun is not configured)
SMTP_RECEIVER_ENABLED=true
SMTP_RECEIVER_PORT=2525
# Only needed if routing inbound mail through Mailgun instead of the SMTP receiver above
MAILGUN_WEBHOOK_SIGNING_KEY=

# ---- YouTube OAuth sync (Upgrade 4) ----
# From https://console.cloud.google.com/apis/credentials — OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=changeme_google_oauth_client_id
GOOGLE_CLIENT_SECRET=changeme_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8091/api/integrations/youtube/callback
# AES-256 key for encrypting stored OAuth tokens at rest. Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=changeme_run_openssl_rand_hex_32_and_paste_the_output_here

# ---- Web push notifications (Upgrade 5) ----
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=changeme_vapid_public_key
VAPID_PRIVATE_KEY=changeme_vapid_private_key
VAPID_SUBJECT=mailto:support@memoryvault.dev
# Same value as VAPID_PUBLIC_KEY above, exposed to the frontend build (public key only, safe to expose)
VITE_VAPID_PUBLIC_KEY=changeme_vapid_public_key
