# MemoryVault — Local Development Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to git (it is in .gitignore).

# ─── Database (MySQL for local dev) ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=33061
DB_NAME=memoryvault
DB_USER=memoryvault_app
DB_PASSWORD=local_app_pw_dev_only

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32 (at least 256 bits)
JWT_SECRET=your_32_plus_char_hex_secret_here
JWT_ACCESS_EXPIRY_MS=900000      # 15 minutes
JWT_REFRESH_EXPIRY_MS=604800000  # 7 days

# ─── Server ───────────────────────────────────────────────────────────────────
SERVER_PORT=8091
SPRING_PROFILE=dev

# ─── AI / Enrichment (optional for local dev) ─────────────────────────────────
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ─── Email Inbound (optional) ─────────────────────────────────────────────────
SMTP_RECEIVER_ENABLED=false
MAILGUN_WEBHOOK_SIGNING_KEY=
VAULT_EMAIL_DOMAIN=vault.stacknode.dev

# ─── Google OAuth / YouTube (optional) ───────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8091/api/integrations/youtube/callback

# ─── Push Notifications (optional) ───────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@memoryvault.dev

# ─── Token Encryption (optional) ─────────────────────────────────────────────
TOKEN_ENCRYPTION_KEY=

# ─── CORS (comma-separated origins) ──────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173
